{
  "name": "AnimalPurchaseFinance",
  "type": "object",
  "properties": {
    "animal_id": {
      "type": "string"
    },
    "purchase_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "purchase_notes": {
      "type": "string"
    }
  },
  "required": [
    "animal_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}