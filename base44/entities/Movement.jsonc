{
  "name": "Movement",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "bulk",
        "individual"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "movement_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "from_farm_id": {
      "type": "string"
    },
    "from_camp_id": {
      "type": "string"
    },
    "to_farm_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "to_camp_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "destination_type": {
      "type": "string",
      "enum": [
        "camp",
        "manual"
      ],
      "default": "camp"
    },
    "destination_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "species": {
      "type": "string"
    },
    "animal_class": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "animal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "animal_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "type",
    "date",
    "from_camp_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}