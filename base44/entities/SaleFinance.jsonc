{
  "name": "SaleFinance",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string"
    },
    "unit_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "total_price": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "sale_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}